# Postgres connection string (never commit the real one: put it in .env.local).
# Local (docker compose up -d):  postgres://relay:relay@localhost:5432/relaydesk
# Neon / Supabase: paste the pooled connection string from their dashboard.
DATABASE_URL=postgres://relay:relay@localhost:5432/relaydesk

# Optional. Set to "false" to close public sign-up once your team has accounts.
# (The very first account can always sign up and becomes the admin.)
# ALLOW_SIGNUP=false
